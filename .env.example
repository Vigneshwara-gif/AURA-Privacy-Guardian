# AURA configuration template.
#
# Copy to .env in the repository root to apply local overrides:
#
#     Copy-Item .env.example .env
#
# .env is gitignored. .env.example is committed and must never contain a real
# credential.
#
# Every line below is commented out, so copying this file changes nothing. Each
# setting shown here is genuinely read by aura/core/config.py — this is not a
# catalogue of intentions.
#
# Precedence, lowest to highest:
#
#     built-in defaults  <  .env  <  environment variables
#
# Naming: the AURA_ prefix, then __ to descend into a section.
#     AURA_LOG__LEVEL            -> settings.log.level
#     AURA_RISK__BANDS__HIGH     -> settings.risk.bands.high
#
# Values are validated on load. An out-of-range or inconsistent value makes
# AURA refuse to start with an explanatory error, rather than quietly running
# with a broken risk model. Run `aura-doctor` after any change.


# ======================================================================
# Environment
# ======================================================================

# development | production
# Production disables the OpenAPI docs endpoint and forbids demo mode.
#AURA_ENVIRONMENT=development

# Synthetic telemetry for UI development. Rejected outright when
# AURA_ENVIRONMENT=production. Anything produced under this flag must be
# labelled as simulated wherever it is displayed and must never be written to
# the production event store.
#AURA_DEMO_MODE=false


# ======================================================================
# Logging
# ======================================================================

# DEBUG | INFO | WARNING | ERROR | CRITICAL
#AURA_LOG__LEVEL=INFO

# Line-delimited JSON instead of human-readable text.
#AURA_LOG__JSON_FORMAT=false

#AURA_LOG__FILE_ENABLED=true
#AURA_LOG__CONSOLE_ENABLED=true
#AURA_LOG__MAX_BYTES=5242880
#AURA_LOG__BACKUP_COUNT=5

# Leave redaction ON. It is what stops a credential appearing in an exception
# message from being written to a rotating log file on disk.
#AURA_LOG__REDACT_ENABLED=true

# Replaces the account name inside Windows user paths, so C:\Users\alice\...
# is logged as C:\Users\<user>\... The path stays useful for debugging.
#AURA_LOG__REDACT_USER_PATHS=true


# ======================================================================
# Telemetry collection
# ======================================================================

# Seconds between background collections.
#AURA_SENSORS__COLLECTION_INTERVAL_SECONDS=5.0

# Blocking psutil CPU sampling window, in seconds. This is the dominant fixed
# cost of a scan. Shortening it makes scans faster and the CPU reading noisier.
#AURA_SENSORS__CPU_SAMPLE_INTERVAL_SECONDS=0.2

# Drive to report disk statistics for. Empty means auto-detect via
# %SystemDrive%, which is not always C:.
#AURA_SENSORS__DISK_PATH=

# ----------------------------------------------------------------------
# Camera probe — privacy sensitive, off by default
# ----------------------------------------------------------------------
# Enabling this opens the capture device to test whether it can be opened. That
# physically powers the camera on and lights its activity indicator, and holds
# the device so other applications cannot use it. It answers only "can this
# camera be opened", which is not evidence that anything accessed the camera.
#AURA_SENSORS__CAMERA_PROBE_ENABLED=false
#AURA_SENSORS__CAMERA_PROBE_INDEX=0

# ----------------------------------------------------------------------
# Sensitive-file inventory
# ----------------------------------------------------------------------
#AURA_SENSORS__MAX_FILES_SCANNED=2500
#AURA_SENSORS__MAX_FILE_RESULTS=250

# Seconds between filesystem walks. The walk is far too slow for the telemetry
# loop, so it runs on its own schedule.
#AURA_SENSORS__FILE_SCAN_INTERVAL_SECONDS=300.0

# The risk engine consumes only the count. Turning this on stores absolute
# paths to your documents in order to display a number — more data than the
# feature needs.
#AURA_SENSORS__RETAIN_SENSITIVE_FILE_PATHS=false

# Caps on what a single snapshot retains.
#AURA_SENSORS__MAX_ENDPOINTS=100
#AURA_SENSORS__MAX_CONNECTION_RECORDS=150
#AURA_SENSORS__MAX_PROCESS_RECORDS=100


# ======================================================================
# Detection
# ======================================================================

# Expected outlier fraction in the training baseline. Raising it makes the
# detector flag more observations as anomalous.
#AURA_DETECTION__CONTAMINATION=0.10

#AURA_DETECTION__MIN_BASELINE_SAMPLES=10
#AURA_DETECTION__ISOLATION_TREES=300
#AURA_DETECTION__BASELINE_SAMPLES=30
#AURA_DETECTION__BASELINE_INTERVAL_SECONDS=0.5

# Fixed seed. Reproducibility is a correctness property here: the same
# baseline and the same observation must always produce the same verdict.
#AURA_DETECTION__RANDOM_STATE=42


# ======================================================================
# Risk scoring
# ======================================================================
#
# Changing any weight, threshold or band makes new scores incomparable with
# already-stored ones. Increment AURA_RISK__SCORING_VERSION at the same time,
# so historical events remain interpretable instead of being silently
# reinterpreted under the new scale.

#AURA_RISK__SCORING_VERSION=2

# Severity cut points. Must be strictly descending.
#AURA_RISK__BANDS__CRITICAL=80
#AURA_RISK__BANDS__HIGH=55
#AURA_RISK__BANDS__MEDIUM=25
#AURA_RISK__BANDS__LOW=10

# Signal weights. The calibration is intentionally uneven: an ML anomaly scores
# 30 because it is a deviation from this machine's own learned behaviour, while
# a high remote-connection count scores 8 because an idle Windows desktop
# normally holds dozens of remote connections.
#AURA_RISK__WEIGHTS__ML_ANOMALY=30
#AURA_RISK__WEIGHTS__NETWORK_VERY_HIGH=30
#AURA_RISK__WEIGHTS__NETWORK_HIGH=22
#AURA_RISK__WEIGHTS__NETWORK_ELEVATED=10

# Outbound rate thresholds, KB/s.
#AURA_RISK__NETWORK__ELEVATED_KBPS=100.0
#AURA_RISK__NETWORK__HIGH_KBPS=1000.0
#AURA_RISK__NETWORK__VERY_HIGH_KBPS=5000.0

# Remote-connection counts.
#AURA_RISK__CONNECTIONS__WATCH=30
#AURA_RISK__CONNECTIONS__HIGH=75
#AURA_RISK__CONNECTIONS__VERY_HIGH=150

# Process counts, as a multiple of the learned baseline. Ratios rather than
# absolute counts, because a normal process count is machine-specific.
#AURA_RISK__PROCESS__WATCH=1.35
#AURA_RISK__PROCESS__ELEVATED=1.75
#AURA_RISK__PROCESS__VERY_HIGH=2.0


# ======================================================================
# Storage
# ======================================================================

# Any SQLAlchemy URL. Empty means SQLite inside the AURA user-data directory.
# If you set a URL containing a password, remember this file's contents end up
# in .env — keep it out of version control and out of shared folders.
#AURA_STORAGE__DATABASE_URL=

#AURA_STORAGE__RETENTION_DAYS=90
#AURA_STORAGE__METRICS_RETENTION_DAYS=14
#AURA_STORAGE__CLEANUP_INTERVAL_HOURS=24
#AURA_STORAGE__SQLITE_JOURNAL_MODE=WAL
#AURA_STORAGE__SQLITE_BUSY_TIMEOUT_SECONDS=5.0


# ======================================================================
# Alerting
# ======================================================================

#AURA_ALERTS__ENABLED=true
#AURA_ALERTS__MIN_SEVERITY=MEDIUM
#AURA_ALERTS__DEDUP_WINDOW_SECONDS=300.0
#AURA_ALERTS__COOLDOWN_SECONDS=600.0
#AURA_ALERTS__ESCALATION_REPEAT_COUNT=3
#AURA_ALERTS__MAX_ACTIVE_ALERTS=500


# ======================================================================
# HTTP API
# ======================================================================
#
# This is the one genuinely new attack surface in the project, so the defaults
# are restrictive.

# Loopback only. 0.0.0.0 is rejected outright: bind to a specific interface so
# the exposure is explicit and auditable.
#AURA_API__HOST=127.0.0.1
#AURA_API__PORT=8787

# Required before any non-loopback bind is permitted. Setting it exposes this
# machine's telemetry to the network — configure authentication first.
#AURA_API__ALLOW_NETWORK_EXPOSURE=false

#AURA_API__RATE_LIMIT_PER_MINUTE=240
#AURA_API__WEBSOCKET_HEARTBEAT_SECONDS=20.0

# Unset follows the environment: docs on in development, off in production.
#AURA_API__DOCS_ENABLED=


# ======================================================================
# Paths
# ======================================================================
#
# These two are read directly by aura/core/paths.py, before configuration is
# loaded, so they are NOT prefixed as nested settings.

# Overrides the user-data root entirely. Highest priority.
#AURA_HOME=

# Keeps all runtime data in .aura-dev/ inside the repository. Convenient while
# developing; .aura-dev/ is gitignored.
#AURA_DEV_MODE=0
